@model StudentVM
@{
    ViewData["Title"] = "Create";
}


<div class="row">
    <div class="col">
        <div id="panel"></div>
        <form id="frmCreate" 
            asp-action="Create" 
            asp-controller="Students" 
              data-ajax-method="post" 
              data-ajax-mode="replace" 
              data-ajax-update="#panel" 
              data-ajax-success="success"
            data-ajax="true" enctype="multipart/form-data">
            <div class="d-flex justify-content-between">
                <div class="col-6">
                    <h1 class="display-5">Add New Student</h1>
                    <div class="row mb-2">
                        <label class="col-form-label col-form-label-sm col-3" asp-for="StudentName"></label>
                        <div class="col-7">
                            <input asp-for="StudentName" class="form-control form-control-sm" />
                        </div>
                        <div class="col-2">
                            <span asp-validation-for="StudentName" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row mb-2">
                        <label class="col-form-label col-form-label-sm col-3" asp-for="BirthDate"></label>
                        <div class="col-7">
                            <input asp-for="BirthDate" class="form-control form-control-sm" type="date" />
                        </div>
                        <div class="col-2">
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row mb-2">
                        <label class="col-form-label col-form-label-sm col-3" asp-for="Age"></label>
                        <div class="col-7">
                            <input asp-for="Age" class="form-control form-control-sm" />
                        </div>
                        <div class="col-2">
                            <span asp-validation-for="Age" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-form-label col-form-label-sm col-3" asp-for="PictureFile"></label>
                        <div class="col-7">
                            <input asp-for="PictureFile" class="form-control form-control-sm" type="file" />
                        </div>
                        <div class="col-2">
                            <span asp-validation-for="PictureFile" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-form-label col-form-label-sm col-3" asp-for="MaritalStatus"></label>
                        <div class="col-7">
                            <input asp-for="MaritalStatus" type="checkbox" />
                        </div>
                        <div class="col-2">
                            <span asp-validation-for="MaritalStatus" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-2">

                        <div class="col-10 offset-3">
                            <input type="submit" value="Save" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <h1 class="display-5">Course List</h1>
                    <div class="d-flex justify-content-end">
                        <a class="btn btn-outline-primary btn-sm mb-1" id="btnPlus">+</a>
                    </div>
                    <div id="courseContainer">
                        <script>
                            LoadData()
                        </script>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts{
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/ajax/dist/jquery.unobtrusive-ajax.js"></script>

    <script>
        function success(){
            $("#frmCreate").trigger('reset')
        }
    </script>

}
